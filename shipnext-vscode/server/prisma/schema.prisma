generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ShipmentStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
}

model WalletRechargeRequest {
  id     String  @id @default(uuid())
  userId String
  amount Decimal @db.Decimal(12, 2)

  // Razorpay payment details
  upiReference      String? @unique
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  status            String  @default("PENDING")
  paymentMethod     String  @default("RAZORPAY")

  // Legacy encrypted payment screenshot fields
  proofOriginalName  String?
  proofMimeType      String?
  proofFileSize      Int?
  proofEncryptedData Bytes?
  proofEncryptionIv  String?
  proofAuthTag       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

enum ShippingMode {
  EXPRESS_AIR
  NORMAL_AIR
  EXPRESS_SURFACE
  NORMAL_SURFACE
}

enum CourierPartner {
  DELHIVERY
  SKYKING
  BLUEDART
  SHADOWFAX
}

enum ShipmentType {
  DOCUMENT
  NON_DOCUMENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  wallet                 Wallet?
  shipments              Shipment[]
  transactions           WalletTransaction[]
  supportTickets         SupportTicket[]
  // Identity and business verification
  panNumberEncrypted     String?
  aadhaarNumberEncrypted String?
  gstNumberEncrypted     String?

  // Bank details
  bankName               String?
  accountHolderName      String?
  accountNumberEncrypted String?
  branchName             String?
  ifscCode               String?
  createdAt              DateTime @default(now())

  updatedAt              DateTime                 @updatedAt
  shipmentDrafts         ShipmentDraft[]
  notifications          Notification[]
  walletRechargeRequests WalletRechargeRequest[]
  customerDocuments      CustomerDocument[]
  childAccounts          ChildAccount[]
  address                String?
  pincode                String?
  refundRequests         RefundRequest[]
  // Company profile
  companyName            String?
  city                   String?
  state                  String?
  companyLogoUrl         String?
  pickupLocations        PickupLocation[]
  invoiceSettings        CustomerInvoiceSettings?
  shippingLabelSettings  ShippingLabelSettings?
  apiKeys                CustomerApiKey[]
  taxSettings            CustomerTaxSettings?
  invoices               ShipmentInvoice[]
}

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique
  balance Decimal @default(0) @db.Decimal(12, 2)

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          String          @id @default(uuid())
  userId      String
  walletId    String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  reference   String?         @unique

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
}

model RefundRequest {
  id          String       @id @default(uuid())
  userId      String
  shipmentId  String?
  amount      Decimal      @db.Decimal(12, 2)
  reason      String
  adminNote   String?
  status      RefundStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([userId, createdAt])
  @@index([shipmentId])
  @@index([status])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Shipment {
  id             String         @id @default(uuid())
  trackingId     String         @unique
  docketNumber   String?        @unique
  courierPartner String?
  courierAwb     String?        @unique
  labelUrl       String?
  awbAssignedAt  DateTime?
  processingDate DateTime?      @db.Date
  customerId     String
  status         ShipmentStatus @default(PENDING)
  shippingMode   ShippingMode?

  pickupName    String
  pickupPhone   String
  pickupAddress String
  pickupPincode String

  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryPincode String

  weightGrams Int

  shippingCharge       Decimal  @db.Decimal(12, 2)
  selectedRateOption   String?
  paymentMode          String   @default("WALLET") // ShipNext shipping-charge payment
  recipientPaymentMode String   @default("PREPAID") // Recipient payment type: PREPAID or COD
  // CASH ON DELIVERY TRACKING
  codAmount            Decimal? @db.Decimal(12, 2)
  codCharge            Decimal? @db.Decimal(12, 2)
  codNetAmount         Decimal? @db.Decimal(12, 2)

  codCollectionStatus String? @default("PENDING")

  // Courier → ShipNext remittance
  codRemittanceStatus    String?   @default("PENDING")
  codCollectedAt         DateTime?
  codRemittedAt          DateTime?
  codRemittanceReference String?

  // ShipNext → Customer settlement
  codSettlementStatus    String?   @default("PENDING")
  codSettledAt           DateTime?
  codSettlementReference String?

  customer User             @relation(fields: [customerId], references: [id])
  invoice  ShipmentInvoice?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supportTickets SupportTicket[]
  draftId        String          @unique
  draft          ShipmentDraft   @relation(fields: [draftId], references: [id])
  ndrRecords     NDRRecord[]
  childAccountId String?
  childAccount   ChildAccount?   @relation(fields: [childAccountId], references: [id], onDelete: SetNull)
  refundRequests RefundRequest[]
  productValue   Decimal?        @db.Decimal(12, 2)

  @@index([customerId])
  @@index([status])
  @@index([codCollectionStatus])
  @@index([codRemittanceStatus])
}

model Enquiry {
  id         String  @id @default(uuid())
  name       String
  phone      String
  email      String?
  message    String
  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
}

model ShipmentDraft {
  id         String @id @default(uuid())
  customerId String

  pickupName    String
  pickupPhone   String
  pickupAddress String
  pickupPincode String
  pickupCity    String?
  deliveryCity  String?
  productValue  Decimal? @db.Decimal(12, 2)

  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryPincode String

  weightGrams           Int
  paymentMode           String   @default("PREPAID")
  codAmount             Decimal? @db.Decimal(12, 2)
  // Three internal shipping rate options
  shipNextRate          Decimal? @db.Decimal(12, 2)
  delhiveryExpressRate  Decimal? @db.Decimal(12, 2)
  delhiveryStandardRate Decimal? @db.Decimal(12, 2)

  // Admin rate approval
  rateApprovalStatus     String       @default("PENDING")
  selectedRateOption     String?
  approvedShippingCharge Decimal?     @db.Decimal(12, 2)
  rateApprovedById       String?
  rateApprovedAt         DateTime?
  // Parcel details
  shipmentType           ShipmentType @default(DOCUMENT)
  itemCategory           String?
  itemName               String?
  itemDescription        String?
  shipment               Shipment?

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  shippingMode   ShippingMode?
  childAccountId String?
  childAccount   ChildAccount? @relation(fields: [childAccountId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String   @default("SHIPMENT")
  trackingId String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum CustomerDocumentType {
  AADHAAR
  PAN
  CANCELLED_CHEQUE
}

enum TicketCategory {
  DELIVERY
  PICKUP
  RTO
  CLAIM
  ACCOUNT
  GST
}

enum ChildAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NDRStatus {
  OPEN
  ACTION_REQUIRED
  REATTEMPT_SCHEDULED
  RESOLVED
  RTO_INITIATED
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  customerId   String
  shipmentId   String?
  category     TicketCategory
  subject      String
  message      String
  status       TicketStatus   @default(OPEN)
  adminReply   String?

  customer User      @relation(fields: [customerId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([shipmentId])
  @@index([status])
}

model ServiceabilityMode {
  id              String       @id @default(uuid())
  pickupPincode   String
  deliveryPincode String
  mode            ShippingMode
  priority        Int          @default(1)
  isActive        Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pickupPincode, deliveryPincode, mode])
  @@index([pickupPincode, deliveryPincode, isActive])
}

model CourierPincodeServiceability {
  id        String         @id @default(uuid())
  courier   CourierPartner
  pincode   String
  stateCode String?
  district  String?

  prepaid       Boolean @default(false)
  reversePickup Boolean @default(false)
  repl          Boolean @default(false)
  cod           Boolean @default(false)
  cash          Boolean @default(false)

  // Skyking-specific information
  serviceabilityStatus String?
  // Skyking air serviceability
  firstMile            Boolean @default(false)
  lastMile             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courier, pincode])
  @@index([pincode])
  @@index([courier, pincode])
}

model BlockedPincode {
  id        String   @id @default(uuid())
  pincode   String   @unique
  reason    String?
  blockedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pincode])
}

model AdminNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@index([createdAt])
}

model CustomerDocument {
  id           String               @id @default(uuid())
  customerId   String
  documentType CustomerDocumentType

  originalName String
  mimeType     String
  fileSize     Int

  encryptedData Bytes
  encryptionIv  String
  authTag       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, documentType])
  @@index([customerId])
}

model ChildAccount {
  id            String             @id @default(uuid())
  parentId      String
  accountName   String
  branchName    String
  branchCode    String
  contactPerson String
  email         String
  phone         String
  address       String
  city          String
  state         String
  pincode       String
  status        ChildAccountStatus @default(INACTIVE)

  dailyShipmentLimit Int?
  dailyWalletLimit   Decimal? @db.Decimal(12, 2)

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  shipmentDrafts ShipmentDraft[]
  shipments      Shipment[]

  @@unique([parentId, branchCode])
  @@index([parentId])
  @@index([status])
}

model NDRRecord {
  id              String    @id @default(uuid())
  shipmentId      String
  attemptNumber   Int       @default(1)
  reason          String
  status          NDRStatus @default(OPEN)
  actionRequired  String?
  remarks         String?
  nextAttemptDate DateTime?
  reportedAt      DateTime  @default(now())
  resolvedAt      DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([reportedAt])
  @@index([status])
}

model PickupLocation {
  id     String @id @default(uuid())
  userId String

  locationName String
  contactName  String
  phone        String

  address  String
  landmark String?
  city     String
  state    String
  pincode  String

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerInvoiceSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  invoiceTitle       String?
  templateStyle      String   @default("STANDARD")
  showLogo           Boolean  @default(true)
  showGst            Boolean  @default(true)
  showPan            Boolean  @default(false)
  footerNote         String?
  termsAndConditions String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShippingLabelSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  labelSize         String   @default("4X6")
  orientation       String   @default("PORTRAIT")
  showLogo          Boolean  @default(true)
  showCompanyName   Boolean  @default(true)
  showSenderPhone   Boolean  @default(true)
  showReceiverPhone Boolean  @default(true)
  showOrderId       Boolean  @default(true)
  showPaymentMode   Boolean  @default(true)
  barcodeFormat     String   @default("CODE128")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastFour   String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
}

model CustomerTaxSettings {
  id               String   @id @default(uuid())
  userId           String   @unique
  defaultGstRate   Decimal  @default(18) @db.Decimal(5, 2)
  taxInclusive     Boolean  @default(false)
  reverseCharge    Boolean  @default(false)
  placeOfSupply    String?
  enableGstInvoice Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShipmentInvoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  shipmentId   String @unique
  customerId   String
  docketNumber String

  invoiceDate DateTime @default(now())

  // Customer billing details saved at invoice generation
  billingName    String?
  billingGst     String?
  billingAddress String?
  billingState   String?
  billingPincode String?

  // Invoice amounts
  shippingCharge Decimal @default(0) @db.Decimal(12, 2)
  codCharge      Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @default(0) @db.Decimal(12, 2)

  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  cgstAmount  Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount  Decimal @default(0) @db.Decimal(12, 2)
  igstAmount  Decimal @default(0) @db.Decimal(12, 2)
  totalTax    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus String  @default("PENDING")
  pdfUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([docketNumber])
  @@index([invoiceDate])
}

model PlayingWithNeon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real

  @@map("playing_with_neon")
}
