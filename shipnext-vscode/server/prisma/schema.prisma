
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ShipmentStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
}
enum ShippingMode {
  EXPRESS_AIR
  NORMAL_AIR
  EXPRESS_SURFACE
  NORMAL_SURFACE
}
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  wallet       Wallet?
  shipments    Shipment[]
  transactions WalletTransaction[]
  supportTickets SupportTicket[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shipmentDrafts ShipmentDraft[]
  notifications Notification[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          String          @id @default(uuid())
  userId      String
  walletId    String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  reference   String?         @unique

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
}

model Shipment {
  id                 String         @id @default(uuid())
  trackingId         String         @unique
    docketNumber   String?   @unique
  processingDate DateTime? @db.Date
  customerId         String
  status             ShipmentStatus @default(PENDING)
  shippingMode ShippingMode?

  pickupName         String
  pickupPhone        String
  pickupAddress      String
  pickupPincode      String

  deliveryName       String
  deliveryPhone      String
  deliveryAddress    String
  deliveryPincode    String

  weightGrams        Int
  shippingCharge     Decimal        @db.Decimal(12, 2)
  paymentMode        String

  customer           User           @relation(fields: [customerId], references: [id])

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
  supportTickets SupportTicket[]
}

model Enquiry {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
}
model ShipmentDraft {
  id              String   @id @default(uuid())
  customerId      String

  pickupName      String
  pickupPhone     String
  pickupAddress   String
  pickupPincode   String

  deliveryName    String
  deliveryPhone  String
  deliveryAddress String
  deliveryPincode String

  weightGrams     Int

  customer        User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  shippingMode ShippingMode?
}
model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String
  type        String   @default("SHIPMENT")
  trackingId  String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
enum TicketCategory {
  DELIVERY
  PICKUP
  RTO
  CLAIM
  ACCOUNT
  GST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
model SupportTicket {
  id          String         @id @default(uuid())
  ticketNumber String        @unique
  customerId  String
  shipmentId  String?
  category    TicketCategory
  subject     String
  message     String
  status      TicketStatus   @default(OPEN)
  adminReply  String?

  customer User      @relation(fields: [customerId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([shipmentId])
  @@index([status])
}
model ServiceabilityMode {
  id              String      @id @default(uuid())
  pickupPincode   String
  deliveryPincode String
  mode            ShippingMode
  priority        Int          @default(1)
  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([pickupPincode, deliveryPincode, mode])
  @@index([pickupPincode, deliveryPincode, isActive])
}